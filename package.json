{
  "name": "@nickw8/bash-mcp",
  "version": "2.0.0",
  "description": "MCP server that wraps CLI tools and returns structured JSON instead of raw text output",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickw8/bash-mcp.git"
  },
  "homepage": "https://github.com/nickw8/bash-mcp#readme",
  "bugs": {
    "url": "https://github.com/nickw8/bash-mcp/issues"
  },
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "kubectl",
    "terraform",
    "helm",
    "argocd",
    "git",
    "jq",
    "yq",
    "structured-output"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "hooks",
    "!hooks/**/*.test.ts",
    "claude",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#error": "./src/error.ts",
    "#exec": "./src/exec.ts",
    "#format": "./src/format.ts",
    "#logger": "./src/logger.ts",
    "#response": "./src/response.ts",
    "#safety": "./src/safety.ts",
    "#tool": "./src/tool.ts",
    "#kube-args": "./src/tools/kube-args.ts",
    "#parsers": "./src/parsers/index.ts",
    "#platform": "./src/platform.ts",
    "#shape": "./src/shape.ts",
    "#step": "./src/step.ts"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "bash-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "docs:tools": "tsx scripts/gen-tool-docs.mjs",
    "claude:install": "tsx scripts/install-claude-assets.mjs",
    "claude:check": "tsx scripts/install-claude-assets.mjs --check",
    "prepublishOnly": "npm run build && node scripts/verify-bundle.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node": "^22.15.0",
    "@typescript/native-preview": "^7.0.0-dev.20260414.1",
    "js-tiktoken": "^1.0.21",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
